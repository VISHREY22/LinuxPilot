# LinuxPilot needs no secrets or API keys: it talks only to this computer's desktop over D-Bus.
# Copy to .env (git-ignored) for local overrides, then `set -a; . ./.env; set +a` before `uv run ...`,
# or put the same variables in your MCP client's "env" block. Every setting is optional.

# --- Server -----------------------------------------------------------------------------------------
# LINUXPILOT_PROFILE=standard            # minimal | standard | full (which tools are offered)
# LINUXPILOT_LOG_LEVEL=info              # debug | info | warning | error
# LINUXPILOT_ENGINE=linux                # linux | fake (scripted demo desktop, touches nothing)

# --- Safety -------------------------------------------------------------------------------------------
# LINUXPILOT_CONFIRM_FALLBACK=deny       # deny | allow: confirmations when the client cannot ask the person
# LINUXPILOT_MAX_ACTIONS_PER_MINUTE=120
# LINUXPILOT_YIELD_TO_USER=true          # pause while the person is typing or moving the mouse
# LINUXPILOT_TITLED_TOOL_NAMES=false     # true: tools are named LinuxPilot_Click etc. (for clients that show names, e.g. Devin)
# LINUXPILOT_SHELL_ENABLED=true          # false: no typing into terminals (destructive commands are confirmed anyway)
# LINUXPILOT_CONSENT_DIALOGS=false       # true: allow per-session portal dialogs instead of `linuxpilot setup`

# --- Behaviour ------------------------------------------------------------------------------------------
# LINUXPILOT_EVENTS=1                    # 0: settle by rereading windows instead of change events
# LINUXPILOT_INDICATOR=1                 # 0: no on-screen border/label while acting

# --- Paths (defaults follow the XDG base directories) -----------------------------------------------------
# LINUXPILOT_SCREENSHOTS_DIR=./linuxpilot-screenshots
# LINUXPILOT_STATE_DIR=~/.local/state/linuxpilot   # audit log, execution log, screenshot permission
# LINUXPILOT_CONFIG_DIR=~/.config/linuxpilot       # config.toml

# --- Publishing (maintainers only) ------------------------------------------------------------------------
# UV_PUBLISH_TOKEN=pypi-...              # `uv publish`; keep it here, never in the repository
